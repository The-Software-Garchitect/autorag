# Optional. Leave these unset and answers are quotes from the files.
# Set generator in autorag.yaml to openai or ollama, or set AUTORAG_GENERATOR.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# extractive | ollama | openai | auto
AUTORAG_GENERATOR=extractive
