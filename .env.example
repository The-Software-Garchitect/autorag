# Copy to .env if you want a hosted model. Leave these unset to use the free local path
# (sentence-transformers for embeddings, extractive answers, or Ollama when it is running).

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Ollama is optional. `docker compose --profile ollama up` starts it.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# auto | extractive | ollama | openai
AUTORAG_GENERATOR=auto

# local | chroma
AUTORAG_INDEX=local
